# Local (sin instalar Postgres): SQLite
DATABASE_URL="file:./dev.db"

# Producción (Neon / Supabase). Cambiá el provider a postgresql en prisma/schema.prisma
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CENTRO_NOMBRE="Centro Médico"

# PIN de 4 dígitos para /recepcion (no lo pongas en NEXT_PUBLIC_)
RECEPCION_PIN="2580"

# Secreto para cifrar nombre, apellido, DNI y foto en la base.
# Si lo cambiás, los registros viejos no se van a poder leer.
ENCRYPTION_KEY="cambiar-por-un-secreto-largo-y-aleatorio"
